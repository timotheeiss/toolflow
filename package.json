{
  "name": "toolflow",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "test:integration": "pnpm --filter @toolflow/database test:integration",
    "typecheck": "turbo run typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @toolflow/database generate",
    "db:migrate": "pnpm --filter @toolflow/database migrate",
    "db:seed": "pnpm --filter @toolflow/database seed",
    "db:bootstrap:pilot": "pnpm --filter @toolflow/database bootstrap:pilot"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@eslint/js": "^9.33.0",
    "@types/node": "^22.17.0",
    "eslint": "^9.33.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^3.2.4"
  }
}
