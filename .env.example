NODE_ENV=development
TOOLFLOW_DEPLOYMENT_TIER=standard
DATABASE_URL=postgresql://toolflow:toolflow@localhost:5432/toolflow
DIRECT_DATABASE_URL=
TOOLFLOW_DATABASE_POOL_MAX=10
TOOLFLOW_AUTH_MODE=development
TOOLFLOW_ADMIN_ORIGIN=http://127.0.0.1:5173
TOOLFLOW_ALLOW_INSECURE_DATABASE_TLS=true
TOOLFLOW_SECRET_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
TOOLFLOW_SECRET_BACKEND=local
TOOLFLOW_COOKIE_DOMAIN=
TOOLFLOW_KMS_URL=https://kms-broker.toolflow.example
TOOLFLOW_KMS_SERVICE_TOKEN=replace-with-at-least-32-random-characters
TOOLFLOW_KMS_KEY_ID=projects/toolflow/locations/global/keyRings/platform/cryptoKeys/connections
TOOLFLOW_KMS_PROVIDER_NAME=kms
TOOLFLOW_BASE_URL=http://localhost:3000
TOOLFLOW_MCP_URL=http://localhost:3001/mcp
TOOLFLOW_MCP_RESOURCE_URL=http://127.0.0.1:3001/mcp
TOOLFLOW_MCP_ALLOWED_HOSTS=127.0.0.1,localhost
TOOLFLOW_MCP_ALLOWED_ORIGINS=127.0.0.1,localhost
TOOLFLOW_OBJECT_STORE_PATH=.toolflow/objects
TOOLFLOW_RUNTIME_BASE_URL=http://127.0.0.1:3004
TOOLFLOW_DATA_GATEWAY_URL=http://127.0.0.1:3005
TOOLFLOW_DEPLOYMENT_SERVICE_URL=http://127.0.0.1:3006
TOOLFLOW_DEPLOYMENT_SERVICE_TOKEN=replace-with-at-least-32-random-characters
TOOLFLOW_BUILD_EXECUTION=inline
TOOLFLOW_BUILD_SERVICE_URL=
TOOLFLOW_BUILD_SERVICE_TOKEN=replace-with-at-least-32-random-characters
TOOLFLOW_BUILD_POLL_INTERVAL_MS=500
TOOLFLOW_BUILD_TIMEOUT_MS=300000
TOOLFLOW_BUILD_MAX_ARTIFACT_BYTES=8388608
TOOLFLOW_BUILD_LOG_RETENTION_DAYS=30
TOOLFLOW_RUNTIME_CONTEXT_SECRET=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
TOOLFLOW_RUNTIME_AUTHORIZATION_SERVICE_TOKEN=replace-with-at-least-32-random-characters
# Cloudflare dispatch Worker variables. Keep these HTTPS-only in production.
TOOLFLOW_AUTHORIZATION_ORIGIN=https://runtime-auth.toolflow.example
TOOLFLOW_APP_BASE_HOST=apps.toolflow.example
TOOLFLOW_DATA_GATEWAY_ORIGIN=https://data.toolflow.example
TOOLFLOW_HEALTH_SERVICE_TOKEN=replace-with-at-least-32-random-characters
TOOLFLOW_RUNTIME_CPU_MS=50
TOOLFLOW_RUNTIME_SUBREQUESTS=10
TOOLFLOW_RUNTIME_MAX_RESPONSE_BYTES=8388608
TOOLFLOW_RUNTIME_MAX_DURATION_MS=30000
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_COOKIE_PASSWORD=
WORKOS_ISSUER=
WORKOS_AUDIENCE=
WORKOS_JWKS_URL=
WORKOS_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
VITE_CONTROL_API_URL=http://localhost:3000
VITE_DEV_AUTH=true
VITE_DEV_USER_ID=00000000-0000-4000-8000-000000000001
VITE_DEV_MEMBERSHIP_ID=00000000-0000-4000-8000-000000000002
VITE_DEV_ORGANIZATION_ID=00000000-0000-4000-8000-000000000003
VITE_DEV_ROLE=admin
OBJECT_STORAGE_ENDPOINT=
