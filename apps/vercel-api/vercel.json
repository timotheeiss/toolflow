{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "regions": ["cdg1"],
  "functions": {
    "api/index.ts": { "maxDuration": 60 },
    "api/[...path].ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/", "destination": "/api" },
    { "source": "/:path*", "destination": "/api/:path*" }
  ]
}
