{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "regions": ["cdg1"],
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "routes": [
    { "src": "/(?<toolflowPath>.*)", "dest": "/api/index.ts?__toolflow_path=$toolflowPath" }
  ]
}
